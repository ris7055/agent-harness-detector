# HarnessGuard deployment config (SPEC section 13).
# Copy to deploy/config.env and edit. deploy/config.env is gitignored -- never commit it.
#   cp deploy/config.env.example deploy/config.env && vim deploy/config.env

# --- required: your Google Cloud project (the one with trial credit) ---
PROJECT_ID=your-project-id

# --- region / names (defaults are fine) ---
REGION=asia-southeast1
AR_REPO=harnessguard
SQL_INSTANCE=harnessguard-db
SQL_TIER=db-f1-micro
DB_NAME=harnessguard
DB_USER=hg
# BUCKET defaults to ${PROJECT_ID}-harnessguard if left blank.
BUCKET=
BQ_DATASET=harness_detector
PUBSUB_TOPIC=session-events
RUN_SA=harnessguard-run

# --- model / scoring ---
GEMINI_MODEL=gemini-2.5-flash
ALLOW_BELOW=0.50
BLOCK_ABOVE=0.85

# Set to false before the final demo if you want to disable the data-collection
# endpoints on the live site (true while you are collecting human sessions).
ALLOW_DATA_COLLECTION=true
